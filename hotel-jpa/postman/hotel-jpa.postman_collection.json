                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Silva\",\n  \"sexo\": \"Feminino\",\n  \"email\": \"ana@example.com\",\n  \"dataChegada\": \"2027-01-15\",\n  \"numeroNoites\": 3,\n  \"numeroHospedes\": 2,\n  \"mensagem\": \"Quarto silencioso\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
